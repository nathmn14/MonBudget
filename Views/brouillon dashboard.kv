<StatCard>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(5)
    MDLabel:
        text: root.titre
        font_style: "Caption"
        halign: "center"
    MDLabel:
        text: root.montant
        theme_text_color: "Custom"
        text_color: root.couleur_texte
        font_style: "H6"
        halign: "center"
        bold: True

<DashboardScreen>:
    orientation: 'vertical'
    md_bg_color: 0.95, 0.95, 0.95, 1

    # 1. HEADER
    MDBoxLayout:
        orientation: 'vertical'
        adaptive_height: True
        padding: [dp(20), dp(20), dp(20), dp(10)]
        MDLabel:
            text: "MonBudget"
            font_style: "H5"
            bold: True
        MDLabel:
            text: "Bienvenue"
            theme_text_color: "Secondary"

    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            padding: dp(15)
            spacing: dp(20)

            # 2. CARTE SOLDE DU MOIS
            MDCard:
                size_hint_y: None
                height: dp(100)
                radius: dp(15)
                padding: dp(15)
                elevation: 1
                orientation: 'vertical'
                MDLabel:
                    text: "Solde du mois"
                    halign: "center"
                MDLabel:
                    text: "25 000 FC"
                    font_style: "H4"
                    halign: "center"
                    theme_text_color: "Primary"
                    bold: True

            # 3. REVENUS VS DEPENSES
            MDBoxLayout:
                adaptive_height: True
                spacing: dp(15)

                MDCard:
                    radius: dp(15)
                    adaptive_height: True
                    StatCard:
                        titre: "Dépenses"
                        montant: "-18 000 FC"
                        couleur_texte: 1, 0.3, 0.3, 1 # Rose/Rouge

                MDCard:
                    radius: dp(15)
                    adaptive_height: True
                    StatCard:
                        titre: "Revenus"
                        montant: "+43 000 FC"
                        couleur_texte: 0.1, 0.7, 0.3, 1 # Vert

            # 4. ZONE GRAPHIQUE
            MDCard:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(250)
                radius: dp(15)
                padding: dp(15)
                MDLabel:
                    text: "Revenus vs Dépenses"
                    bold: True
                    adaptive_height: True

                MDFloatLayout:
                    MDLabel:
                        text: "Graphique Barres (Jan-Mar)"
                        halign: "center"
                        theme_text_color: "Hint"

            # 5. DÉPENSES PAR CATÉGORIE
            MDBoxLayout:
                orientation: 'vertical'
                adaptive_height: True
                spacing: dp(10)
                MDLabel:
                    text: "Dépenses par catégorie"
                    bold: True

                # Exemple de ligne (Alimentation)
                MDCard:
                    size_hint_y: None
                    height: dp(56)
                    padding: dp(12)
                    radius: dp(10)
                    MDBoxLayout:
                        orientation: 'horizontal'
                        MDLabel:
                            text: "Alimentation"
                            valign: "center"
                        MDLabel:
                            text: "8 000 FC"
                            halign: "right"
                            bold: True
                            valign: "center"