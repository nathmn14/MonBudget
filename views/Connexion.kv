<KeyButton@MDCard>:
    digit: ""
    # On cible explicitement l'écran de connexion pour éviter les erreurs lors de la transition
    on_release: app.root.get_screen('login_screen').add_digit(root.digit)
    size_hint: None, None
    size: "80dp", "70dp"
    elevation: 1
    radius: [15, ]
    ripple_behavior: True
    md_bg_color: [1, 1, 1, 1] if app.theme_cls.theme_style == "Light" else [0.2, 0.2, 0.2, 1]
    MDLabel:
        text: root.digit
        halign: "center"
        font_style: "H5"
        theme_text_color: "Primary"

<LoginScreen>:
    md_bg_color: [0.96, 0.97, 0.98, 1] if app.theme_cls.theme_style == "Light" else [0.13, 0.13, 0.13, 1]

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"

        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            width: "320dp"
            size_hint_x: None
            padding: "20dp"
            spacing: "15dp"
            pos_hint: {"center_x": .5}

            # --- SECTION HEADER ---
            MDBoxLayout:
                orientation: 'vertical'
                adaptive_height: True
                spacing: "10dp"

                MDFloatLayout:
                    size_hint: None, None
                    size: "70dp", "70dp"
                    pos_hint: {"center_x": .5}
                    canvas.before:
                        Color:
                            rgba: 0.12, 0.53, 0.9, 1
                        Ellipse:
                            pos: self.pos
                            size: self.size
                    MDIcon:
                        icon: "lock-outline"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        pos_hint: {"center_x": .5, "center_y": .5}
                        font_size: "35dp"

                MDLabel:
                    text: "MonBudget"
                    halign: "center"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Primary"

                Widget:
                    size_hint_y: None
                    height: dp(10)

                MDLabel:
                    text: "Sécurité"
                    halign: "center"
                    font_style: "Subtitle2"
                    theme_text_color: "Secondary"

                Widget:
                    size_hint_y: None
                    height: dp(10)

                MDLabel:
                    id: change_pwd_label
                    text: "⚠️ Veuillez changer votre mot de passe par défaut (0000)"
                    halign: "center"
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: 1, 0.5, 0, 1
                    size_hint_y: None
                    height: "30dp"
                    opacity: 0

                MDLabel:
                    id: error_label
                    text: ""
                    halign: "center"
                    font_style: "Caption"
                    theme_text_color: "Error"
                    size_hint_y: None
                    height: "20dp"
                    opacity: 0

            # --- SECTION INDICATEURS PIN ---
            MDBoxLayout:
                orientation: 'horizontal'
                adaptive_size: True
                pos_hint: {"center_x": .5}
                spacing: "15dp"
                padding: [0, "10dp", 0, "20dp"]

                MDCard:
                    id: dot_1
                    size_hint: None, None
                    size: "15dp", "15dp"
                    radius: [7.5, ]
                    md_bg_color: [0.8, 0.8, 0.8, 0.5] if app.theme_cls.theme_style == "Light" else [0.5, 0.5, 0.5, 0.5]
                    elevation: 0
                MDCard:
                    id: dot_2
                    size_hint: None, None
                    size: "15dp", "15dp"
                    radius: [7.5, ]
                    md_bg_color: [0.8, 0.8, 0.8, 0.5] if app.theme_cls.theme_style == "Light" else [0.5, 0.5, 0.5, 0.5]
                    elevation: 0
                MDCard:
                    id: dot_3
                    size_hint: None, None
                    size: "15dp", "15dp"
                    radius: [7.5, ]
                    md_bg_color: [0.8, 0.8, 0.8, 0.5] if app.theme_cls.theme_style == "Light" else [0.5, 0.5, 0.5, 0.5]
                    elevation: 0
                MDCard:
                    id: dot_4
                    size_hint: None, None
                    size: "15dp", "15dp"
                    radius: [7.5, ]
                    md_bg_color: [0.8, 0.8, 0.8, 0.5] if app.theme_cls.theme_style == "Light" else [0.5, 0.5, 0.5, 0.5]
                    elevation: 0

            # --- SECTION CLAVIER ---
            MDGridLayout:
                cols: 3
                adaptive_size: True
                pos_hint: {"center_x": .5}
                spacing: "15dp"
                padding: "10dp"

                KeyButton:
                    digit: "1"
                KeyButton:
                    digit: "2"
                KeyButton:
                    digit: "3"
                KeyButton:
                    digit: "4"
                KeyButton:
                    digit: "5"
                KeyButton:
                    digit: "6"
                KeyButton:
                    digit: "7"
                KeyButton:
                    digit: "8"
                KeyButton:
                    digit: "9"

                MDWidget:
                    size_hint: None, None
                    size: "80dp", "70dp"

                KeyButton:
                    digit: "0"

                MDCard:
                    size_hint: None, None
                    size: "80dp", "70dp"
                    elevation: 1
                    radius: [15,]
                    md_bg_color: [1, 1, 1, 1] if app.theme_cls.theme_style == "Light" else [0.2, 0.2, 0.2, 1]
                    ripple_behavior: True
                    on_release: root.delete_digit()

                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"

                        MDIcon:
                            icon: "backspace-outline"
                            theme_text_color: "Primary"